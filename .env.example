# Used only by the offline evaluation runner. The web app takes a visitor's key.
GOOGLE_API_KEY=
# Optional process environment for both the server and evaluation runner:
# DOCUMIND_MODEL=gemini-3.5-flash-lite
# DOCUMIND_EMBED_MODEL=BAAI/bge-small-en-v1.5
# DOCUMIND_DATA=instance/documind
# Optional complete USD-per-million price override for the configured model.
# Set all three together. Unknown model prices are displayed as unavailable.
# DOCUMIND_INPUT_USD_PER_M=0.30
# DOCUMIND_OUTPUT_USD_PER_M=2.50
# DOCUMIND_CACHED_USD_PER_M=0.03
